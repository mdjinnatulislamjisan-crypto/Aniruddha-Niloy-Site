# ---------------------------------------------------------------
# Copy this file to ".env.local" and fill in your own values.
# NEVER commit .env.local to Git. It is already in .gitignore.
# ---------------------------------------------------------------

# Supabase -> Project Settings -> API
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. This key is designed to be public,
# because Row Level Security protects your data.
# DO NOT put the "service_role" / "secret" key anywhere in this project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your public website address (no trailing slash).
# Local:       http://localhost:3000
# Production:  https://your-domain.com  (or your .vercel.app address)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social links (replace with your real pages)
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your-page-here
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-profile-here
